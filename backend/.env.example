# DataSentinel AI - Environment Variables
# Copy this file to .env and fill in values

# Optional: OpenAI API key for AI-powered investigation
# When not set, the app uses rule-based demo mode
OPENAI_API_KEY=

# Optional: Model to use (default: gpt-3.5-turbo)
LLM_MODEL=gpt-3.5-turbo

# Server settings
HOST=0.0.0.0
PORT=8000
